# Build output (`ym build`, `ym artifact build`)
/dist/
/dist-artifacts/

# Python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Leftovers from an interrupted `ym core` / `ym plugin sync` swap
/.yourls.old-*
/.yourls.new-*

# Secrets and dumps never enter Git: the real config lives on the server only
/server/*.php
!/server/config.example.php
.env
*.sql
*.sql.gz

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# NOTE: yourls/ (vendored core + plugins) and uv.lock ARE committed. yourls/ must be
# committed exactly as `ym core` / `ym plugin sync` vendored it (yourls.lock.json hashes
# every file), so none of the patterns above apply inside it (e.g. a plugin's *.sql file).
!/yourls/**
