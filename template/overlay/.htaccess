# Template-owned (yourls-site-template). Copied over the vendored YOURLS tree at build time.

# No directory listings (e.g. for the site root when no index file exists).
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Deny dotfiles and dot-directories (.git, .env, ...) except /.well-known/
# (ACME challenges etc.).
RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]
</IfModule>

# Deny repository/tooling files that are not part of the running site.
<FilesMatch "(?i)^(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml(\.dist)?|.*\.md|.*\.sql(\.gz)?|.*\.log|.*\.bak|.*~)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# BEGIN YOURLS
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^.*$ /yourls-loader.php [L]
</IfModule>
# END YOURLS
