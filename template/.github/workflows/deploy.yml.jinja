# Template-owned (yourls-site-template). Deploys {{ site_name }} with yourls-manager.
#
# Triggers: pushing a release tag (`ym release --push`): v<yourls>-<rev> deploys "prod",
# v<yourls>-<rev>-rc.<n> deploys "staging" when site.toml defines it (skipped otherwise);
# or manual dispatch with a target name. `ym deploy` enforces each target's `accept` policy
# (prod: final release tags only), so a manual run can't bypass it.
# Setup (repo Settings -> Environments -> "production" and "staging"; add required reviewers
# to production if wanted), on each environment:
#   DEPLOY_SSH_KEY      private key (ed25519) whose public half is in ~/.ssh/authorized_keys on the host
#   DEPLOY_KNOWN_HOSTS  output of `ssh-keyscan -p <port> <host>` (verify the fingerprint!)
name: deploy

on:
  push:
    tags: ["v*"]
  workflow_dispatch:
    inputs:
      target:
        description: "Deploy target name from site.toml [deploy.targets.<name>]"
        required: true
        default: prod
        type: string

permissions:
  contents: read

concurrency:
  group: deploy-{% raw %}${{ github.ref_name }}-${{ inputs.target }}{% endraw %}
  cancel-in-progress: false

jobs:
  resolve:
    runs-on: ubuntu-latest
    outputs:
      target: ${{ '{{' }} steps.pick.outputs.target {{ '}}' }}
    steps:
      - uses: actions/checkout@v7
        with:
          persist-credentials: false
      - id: pick
        env:
{%- raw %}
          INPUT_TARGET: ${{ inputs.target }}
          REF_NAME: ${{ github.ref_name }}
{%- endraw %}
        run: |
          if [ -n "$INPUT_TARGET" ]; then target="$INPUT_TARGET"
          elif [[ "$REF_NAME" == *-rc.* ]]; then target=staging
          else target=prod
          fi
          if ! grep -Eq "^\[deploy\.targets\.${target}\]" site.toml; then
            echo "::notice::no [deploy.targets.${target}] in site.toml; nothing to deploy"
            target=""
          fi
          echo "target=$target" >> "$GITHUB_OUTPUT"

  deploy:
    needs: resolve
    if: needs.resolve.outputs.target != ''
    runs-on: ubuntu-latest
    environment: ${{ '{{' }} needs.resolve.outputs.target == 'prod' && 'production' || 'staging' {{ '}}' }}
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v7
        with:
          persist-credentials: false
          fetch-depth: 0  # tags + remote branches: ym deploy checks the release tag at HEAD

      - uses: astral-sh/setup-uv@v10.3.2
        with:
          enable-cache: true

      - name: Install yourls-manager
        run: uv sync --locked

      - name: Configure SSH
        env:
{%- raw %}
          DEPLOY_SSH_KEY: ${{ secrets.DEPLOY_SSH_KEY }}
          DEPLOY_KNOWN_HOSTS: ${{ secrets.DEPLOY_KNOWN_HOSTS }}
{%- endraw %}
        run: |
          if [ -z "$DEPLOY_SSH_KEY" ] || [ -z "$DEPLOY_KNOWN_HOSTS" ]; then
            echo "::error::Secrets DEPLOY_SSH_KEY and DEPLOY_KNOWN_HOSTS must be set on this deploy environment"
            exit 1
          fi
          install -m 700 -d ~/.ssh
          printf '%s\n' "$DEPLOY_SSH_KEY" > ~/.ssh/id_ed25519
          chmod 600 ~/.ssh/id_ed25519
          printf '%s\n' "$DEPLOY_KNOWN_HOSTS" > ~/.ssh/known_hosts
          chmod 644 ~/.ssh/known_hosts
          printf 'Host *\n  IdentityFile ~/.ssh/id_ed25519\n  IdentitiesOnly yes\n  StrictHostKeyChecking yes\n' > ~/.ssh/config
          chmod 600 ~/.ssh/config

      - name: Deploy
        env:
          TARGET: {% raw %}${{ needs.resolve.outputs.target }}{% endraw %}
        run: uv run --locked ym deploy "$TARGET"

      - name: Remove SSH key
        if: always()
        run: rm -f ~/.ssh/id_ed25519
